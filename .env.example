# ---- API (Vercel deployment of src/app/api/send-enquiry/route.ts) ----
# Titan Email (GoDaddy — smtpout.secureserver.net:465) credentials.
TITAN_EMAIL_USER=sales@navkarglobalsourcing.com
TITAN_EMAIL_PASS=
MAIL_TO=sales@navkarglobalsourcing.com
# Origin allowed to call the API (Hostinger site). Use "*" only for testing.
CORS_ALLOW_ORIGIN=https://navkarglobalsourcing.com

# ---- Build target ----
# Default: `npm run build` produces a static export in `out/` (upload to Hostinger).
# On Vercel, set BUILD_SERVER=1 in Project Settings so it builds the full app
# (with the /api/send-enquiry serverless function).
# BUILD_SERVER=1

# Point forms at the Vercel API URL at build time (inlined into the bundle).
# Leave empty for local dev (uses same-origin /api/send-enquiry via next dev).
NEXT_PUBLIC_API_BASE_URL=https://navkar-5rqo.vercel.app
